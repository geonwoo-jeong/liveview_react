# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package archives built by Hex and npm.
liveview_react-*.tar
liveview_react-*.tgz

# Temporary files, for example, from tests.
/tmp/

# Ignore node_modules
/node_modules/
/dist/
/coverage/
/playwright-report/
/test-results/

# Ignore example build and dependency output.
/liveview_react_examples/_build/
/liveview_react_examples/deps/
/liveview_react_examples/assets/node_modules/
/liveview_react_examples/assets/playwright-report/
/liveview_react_examples/assets/test-results/

# LSP elixir
.elixir_ls/
.elixir-tools/
