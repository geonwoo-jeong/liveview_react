{
  "name": "liveview_react_examples-assets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build-server": "npm run typecheck && vite build --ssr js/server.ts --out-dir ../priv/liveview_react --minify esbuild && npm run smoke-server",
    "smoke-server": "node scripts/smoke-server.mjs"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-label": "^2.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.11",
    "liveview_react": "file:../..",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "topbar": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
